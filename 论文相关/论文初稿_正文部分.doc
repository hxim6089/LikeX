<tr><td>author</td><td>BIGINT</td><td>作者 ID</td></tr>
<tr><td>parentContent</td><td>BIGINT</td><td>父评论 ID</td></tr>
<tr><td>content</td><td>TEXT</td><td>正文内容</td></tr>
<tr><td>imageUrl</td><td>VARCHAR</td><td>图片地址</td></tr>
<tr><td>category</td><td>VARCHAR</td><td>内容分类</td></tr>
<tr><td>viewCount</td><td>INT</td><td>浏览数</td></tr>
