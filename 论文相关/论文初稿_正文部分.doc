<tr><td>createdAt</td><td>DATETIME</td><td>发布时间</td></tr>
</table>
<p class="table-title">表3-3 行为表设计</p>
<table>
<tr><th>字段</th><th>类型</th><th>说明</th></tr>
<tr><td>id</td><td>BIGINT</td><td>行为 ID</td></tr>
<tr><td>userId</td><td>BIGINT</td><td>用户 ID</td></tr>
