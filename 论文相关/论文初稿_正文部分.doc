<tr><td>target_type</td><td>枚举</td><td>CONTENT（单条内容）或 AUTHOR（作者）</td></tr>
<tr><td>target_id</td><td>BIGINT</td><td>目标内容 ID 或用户 ID</td></tr>
<tr><td>signal_type</td><td>枚举</td><td>NOT_INTERESTED、BLOCK、MUTE</td></tr>
<tr><td>created_at</td><td>DATETIME</td><td>创建时间</td></tr>
</table>
